# ==========================================
# SANKET × CivicLens Environment Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
DEMO_MODE=false

# Database Configuration
# Production: postgresql://postgres:postgres@localhost:5432/sanket_civiclens
# Local fallback: sqlite:///./sanket_civiclens.db (with built-in Python Haversine GIS)
DATABASE_URL=sqlite:///./sanket_civiclens.db

# Security & JWT Auth
JWT_SECRET=super-secret-production-random-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Evidence & Upload Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Official Government Portals (Leave blank for honest "API unavailable" status)
DATA_GOV_IN_API_KEY=
SMART_CITIES_API_KEY=

# RAG / AI Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
AI_VISION_CONFIDENCE_THRESHOLD=0.60
